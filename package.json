    "@opennextjs/cloudflare": "^1.19.9",
    "@react-jvectormap/core": "^1.0.4",
    "@react-jvectormap/world": "^1.1.2",
    "apexcharts": "^5.14.0",
    "flatpickr": "^4.6.13",
    "gsap": "^3.15.0",
    "next": "16.2.6",
    "react": "^19.1.7",
    "react-apexcharts": "^2.1.0",
    "react-dnd": "^16.0.1",
